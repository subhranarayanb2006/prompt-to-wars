{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private dispatcher user profile for an authenticated Domino Sky operator (owner-only PII isolation).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Operator display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified operator email address (strictly owner-only)."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional profile avatar URL."
        },
        "callsign": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Dispatcher shift callsign (e.g. OCC-BOM-01)."
        },
        "homeHub": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$",
          "description": "3-letter IATA code of operator primary hub."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial profile creation (immutable)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest profile update."
        }
      },
      "required": ["uid", "displayName", "email", "callsign", "homeHub", "createdAt", "updatedAt"]
    },
    "WorkspacePreferences": {
      "title": "WorkspacePreferences",
      "description": "Cloud-synced watchlist flight IDs and default dispatch priority for an operator.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the owner."
        },
        "watchlistIds": {
          "type": "array",
          "description": "Bounded list (max 70) of starred flight IDs."
        },
        "defaultPriority": {
          "type": "string",
          "enum": ["BALANCED", "MINIMIZE_STRANDED", "ZERO_CANCELLATIONS", "MINIMIZE_DELAY", "LOW_RESOURCE"],
          "description": "Preferred AI Dispatcher recovery priority."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last preferences sync."
        }
      },
      "required": ["ownerId", "watchlistIds", "defaultPriority", "updatedAt"]
    },
    "SavedScenario": {
      "title": "SavedScenario",
      "description": "Saved airport disruption scenario and applied recovery playbook with deterministic summary metrics.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the scenario owner (immutable)."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Human-readable name of the saved scenario."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Dispatcher notes explaining the playbook or trigger."
        },
        "airportCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$",
          "description": "Closed airport 3-letter IATA code."
        },
        "startMin": {
          "type": "integer",
          "description": "Closure start time in minutes from midnight (300-1200)."
        },
        "endMin": {
          "type": "integer",
          "description": "Closure end time in minutes from midnight (330-1320)."
        },
        "reason": {
          "type": "string",
          "enum": ["Thunderstorm", "Dense Fog", "Runway Closure", "ATC Ground Stop"],
          "description": "Disruption cause category."
        },
        "priority": {
          "type": "string",
          "enum": ["BALANCED", "MINIMIZE_STRANDED", "ZERO_CANCELLATIONS", "MINIMIZE_DELAY", "LOW_RESOURCE"],
          "description": "Dispatch priority selected when saved."
        },
        "actionIds": {
          "type": "array",
          "description": "Bounded list (max 15) of applied recovery action IDs."
        },
        "actionLabels": {
          "type": "array",
          "description": "Bounded list (max 15) of human-readable recovery action labels."
        },
        "baselineStranded": {
          "type": "integer",
          "description": "Deterministic baseline stranded passengers."
        },
        "afterStranded": {
          "type": "integer",
          "description": "Deterministic post-recovery stranded passengers."
        },
        "baselineDelayMin": {
          "type": "integer",
          "description": "Deterministic baseline total delay minutes."
        },
        "afterDelayMin": {
          "type": "integer",
          "description": "Deterministic post-recovery total delay minutes."
        },
        "baselineCancelled": {
          "type": "integer",
          "description": "Deterministic baseline cancelled flights."
        },
        "afterCancelled": {
          "type": "integer",
          "description": "Deterministic post-recovery cancelled flights."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation (immutable)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "ownerId",
        "title",
        "notes",
        "airportCode",
        "startMin",
        "endMin",
        "reason",
        "priority",
        "actionIds",
        "actionLabels",
        "baselineStranded",
        "afterStranded",
        "baselineDelayMin",
        "afterDelayMin",
        "baselineCancelled",
        "afterCancelled",
        "createdAt",
        "updatedAt"
      ]
    },
    "ShiftLogEntry": {
      "title": "ShiftLogEntry",
      "description": "Operational OCC shift handover and incident logbook entry with terminal state locking when resolved.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the log author (immutable)."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Short headline of the operational log entry."
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Detailed operational notes or handover instructions."
        },
        "category": {
          "type": "string",
          "enum": ["INCIDENT", "RECOVERY", "CREW_FDTL", "HANDOVER"],
          "description": "Operational log category."
        },
        "severity": {
          "type": "string",
          "enum": ["ROUTINE", "ADVISORY", "CRITICAL"],
          "description": "Operational severity level."
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"],
          "description": "Lifecycle status; resolved is terminal and locked against further updates."
        },
        "scenarioRef": {
          "type": "string",
          "maxLength": 160,
          "description": "Compact snapshot label of the active scenario when logged."
        },
        "resolvedNote": {
          "type": "string",
          "maxLength": 400,
          "description": "Resolution summary recorded when closing the entry."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation (immutable)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "ownerId",
        "title",
        "notes",
        "category",
        "severity",
        "status",
        "scenarioRef",
        "resolvedNote",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private operator profile keyed by Firebase Auth UID (strictly owner-only)."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/WorkspacePreferences" },
      "description": "Operator workspace preferences including cloud-synced flight watchlist (prefId = 'workspace')."
    },
    "/users/{userId}/scenarios/{scenarioId}": {
      "schema": { "$ref": "#/entities/SavedScenario" },
      "description": "Saved disruption scenarios and deterministic recovery playbooks owned by userId."
    },
    "/users/{userId}/logbook/{entryId}": {
      "schema": { "$ref": "#/entities/ShiftLogEntry" },
      "description": "OCC shift handover and incident logbook entries with terminal resolved state locking."
    }
  }
}
